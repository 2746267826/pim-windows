{
    "{{chrome}}.manifest_version": 3,
    "{{firefox}}.manifest_version": 2,
    "{{safari}}.manifest_version": 3,

    "name": "PIM 浏览器记录",
    "description": "记录当前浏览的网页，供 PIM「电脑记录」使用。",
    "version": "1.0.0",
    "icons": {
        "128": "media/logo/logo-128.png"
    },

    "{{chrome}}.action": {
        "default_icon": { "128": "media/logo/logo-128.png" },
        "default_popup": "src/popup/index.html"
    },
    "{{firefox}}.browser_action": {
        "default_icon": "media/logo/logo-128.png",
        "default_popup": "src/popup/index.html"
    },
    "{{safari}}.action": {
        "default_icon": { "128": "media/logo/logo-128.png" },
        "default_popup": "src/popup/index.html"
    },

    "background": {
        "{{chrome}}.service_worker": "src/background/main.ts",
        "{{chrome}}.type": "module",
        "{{firefox}}.scripts": ["src/background/main.ts"],
        "{{firefox}}.persistent": true,
        "{{safari}}.service_worker": "src/background/main.ts",
        "{{safari}}.type": "module"
    },

    "options_ui": {
        "page": "src/settings/index.html"
    },

    "{{firefox}}.permissions": [
        "tabs",
        "alarms",
        "notifications",
        "activeTab",
        "storage",
        "http://localhost:15601/*",
        "http://127.0.0.1:15601/*",
        "<all_urls>"
    ],
    "{{chrome}}.permissions": [
        "tabs",
        "alarms",
        "notifications",
        "activeTab",
        "offscreen",
        "storage"
    ],
    "{{safari}}.permissions": [
        "tabs",
        "alarms",
        "notifications",
        "activeTab",
        "storage"
    ],
    "{{chrome}}.host_permissions": ["<all_urls>"],
    "{{safari}}.host_permissions": ["<all_urls>"],

    "{{firefox}}.browser_specific_settings": {
        "gecko": {
            "id": "{ef87d84c-2127-493f-b952-5b4e744245bc}"
        }
    }
}
