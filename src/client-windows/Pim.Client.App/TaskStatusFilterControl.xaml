<UserControl x:Class="Pim.Client.App.TaskStatusFilterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                ToolTip="可同时选择多个状态；不选具体状态表示全部">
        <TextBlock Text="状态" FontSize="12" Margin="0,0,6,0"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource PimMutedTextBrush}" />
        <CheckBox x:Name="AllStatusCheck" Content="全部状态" Margin="0,0,10,0"
                  FontSize="12" VerticalAlignment="Center"
                  Checked="OnAllStatusChanged" Unchecked="OnAllStatusChanged" />
        <CheckBox x:Name="NeedsActionCheck" Content="待处理" Tag="NEEDS-ACTION"
                  Margin="0,0,10,0" FontSize="12" VerticalAlignment="Center"
                  Checked="OnStatusChanged" Unchecked="OnStatusChanged" />
        <CheckBox x:Name="InProcessCheck" Content="进行中" Tag="IN-PROCESS"
                  Margin="0,0,10,0" FontSize="12" VerticalAlignment="Center"
                  Checked="OnStatusChanged" Unchecked="OnStatusChanged" />
        <CheckBox x:Name="CompletedCheck" Content="已完成" Tag="COMPLETED"
                  Margin="0,0,10,0" FontSize="12" VerticalAlignment="Center"
                  Checked="OnStatusChanged" Unchecked="OnStatusChanged" />
        <CheckBox x:Name="CancelledCheck" Content="已取消" Tag="CANCELLED"
                  FontSize="12" VerticalAlignment="Center"
                  Checked="OnStatusChanged" Unchecked="OnStatusChanged" />
    </StackPanel>
</UserControl>
