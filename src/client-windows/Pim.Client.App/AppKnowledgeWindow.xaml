<Window x:Class="Pim.Client.App.AppKnowledgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="应用知识与分类" Height="760" Width="1180" MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PimMutedSurfaceBrush}"
        Loaded="OnLoaded" Closing="OnClosing" Closed="OnClosed">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="应用知识与分类" FontSize="24" FontWeight="SemiBold"
                       Foreground="{StaticResource PimTextBrush}" />
            <TextBlock Text="管理电脑活动分类与应用上下文规则；不是笔记全文知识库。"
                       Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource PimMutedTextBrush}" />
        </StackPanel>
        <TabControl x:Name="KnowledgeTabs" Grid.Row="1" Background="{StaticResource PimSurfaceBrush}"
                    BorderBrush="{StaticResource PimBorderBrush}">
            <TabItem Header="分类树">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PimSurfaceBrush}" BorderBrush="{StaticResource PimBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="刷新" Style="{StaticResource PimSecondaryButton}" Click="OnRefreshCategories" />
                                <Button Content="新建分类" Margin="8,0,0,0" Style="{StaticResource PimPrimaryButton}"
                                        Click="OnNewCategory" />
                            </StackPanel>
                            <TreeView x:Name="CategoryTree" SelectedItemChanged="OnCategorySelected">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <TextBlock Text="{Binding Label}" Margin="3" />
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource PimSurfaceBrush}" BorderBrush="{StaticResource PimBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="分类属性" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource PimTextBrush}" />
                                <TextBlock x:Name="BuiltinCategoryNotice" Margin="0,6,0,10" TextWrapping="Wrap"
                                           Foreground="{StaticResource PimMutedTextBrush}" />
                                <TextBlock Text="名称" />
                                <TextBox x:Name="CategoryNameBox" Margin="0,4,0,10" MaxLength="80"
                                         TextChanged="OnCategoryDraftChanged" />
                                <TextBlock Text="颜色（CSS 色值）" />
                                <TextBox x:Name="CategoryColorBox" Margin="0,4,0,10" MaxLength="32"
                                         TextChanged="OnCategoryDraftChanged" />
                                <TextBlock Text="生产力分类" />
                                <ComboBox x:Name="ProductivityBox" Margin="0,4,0,10"
                                          SelectionChanged="OnCategoryDraftSelectionChanged" />
                                <TextBlock Text="父分类" />
                                <ComboBox x:Name="ParentCategoryBox" Margin="0,4,0,12" DisplayMemberPath="Label"
                                          SelectionChanged="OnCategoryDraftSelectionChanged" />
                                <WrapPanel>
                                    <Button x:Name="SaveCategoryButton" Content="保存分类"
                                            Style="{StaticResource PimPrimaryButton}" Click="OnSaveCategory" />
                                    <Button x:Name="DeleteCategoryButton" Content="删除分类" Margin="8,0,0,0"
                                            Style="{StaticResource PimSecondaryButton}" Click="OnDeleteCategory" />
                                </WrapPanel>
                                <TextBlock Text="内置分类只读且不可删除；删除自定义父分类前需先处理其子分类。"
                                           Margin="0,12,0,0" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{StaticResource PimMutedTextBrush}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="应用上下文">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PimSurfaceBrush}" BorderBrush="{StaticResource PimBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="应用" FontSize="16" FontWeight="SemiBold" />
                                <TextBox x:Name="AppSearchBox" Margin="0,8,0,8" Height="32" Padding="8,4"
                                         ToolTip="搜索显示名称或进程名" KeyDown="OnAppSearchKeyDown" />
                                <Button Content="搜索应用" Style="{StaticResource PimSecondaryButton}"
                                        Click="OnSearchApps" Margin="0,0,0,8" />
                            </StackPanel>
                            <ListBox x:Name="AppsList" SelectionChanged="OnAppSelected">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{StaticResource PimMutedTextBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource PimSurfaceBrush}" BorderBrush="{StaticResource PimBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="上下文规则" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Content="新建" Margin="12,0,0,0" Style="{StaticResource PimSecondaryButton}"
                                        Click="OnNewContext" />
                                <Button Content="刷新" Margin="8,0,0,0" Style="{StaticResource PimSecondaryButton}"
                                        Click="OnRefreshContexts" />
                            </StackPanel>
                            <ListBox x:Name="ContextsList" SelectionChanged="OnContextSelected">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{StaticResource PimMutedTextBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="4" Background="{StaticResource PimSurfaceBrush}" BorderBrush="{StaticResource PimBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="编辑上下文" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="SelectedAppText" Margin="0,6,0,10" TextWrapping="Wrap"
                                           Foreground="{StaticResource PimMutedTextBrush}" />
                                <TextBlock Text="匹配类型" />
                                <ComboBox x:Name="PatternTypeBox" Margin="0,4,0,8"
                                          SelectionChanged="OnContextDraftSelectionChanged" />
                                <TextBlock Text="匹配内容" />
                                <TextBox x:Name="PatternValueBox" Margin="0,4,0,8" MaxLength="512"
                                         TextChanged="OnContextDraftChanged" />
                                <TextBlock Text="目标分类（可空）" />
                                <TextBox x:Name="TargetCategoryBox" Margin="0,4,0,8" MaxLength="80"
                                         TextChanged="OnContextDraftChanged" />
                                <TextBlock Text="项目标签（可空）" />
                                <TextBox x:Name="ProjectTagBox" Margin="0,4,0,8" MaxLength="80"
                                         TextChanged="OnContextDraftChanged" />
                                <CheckBox x:Name="ContextEnabledBox" Content="启用规则" Margin="0,4,0,12"
                                          Checked="OnContextDraftCheckChanged" Unchecked="OnContextDraftCheckChanged" />
                                <WrapPanel>
                                    <Button x:Name="SaveContextButton" Content="保存规则"
                                            Style="{StaticResource PimPrimaryButton}" Click="OnSaveContext" />
                                    <Button x:Name="DeleteContextButton" Content="删除规则" Margin="8,0,0,0"
                                            Style="{StaticResource PimSecondaryButton}" Click="OnDeleteContext" />
                                </WrapPanel>
                                <TextBlock Text="保存按当前 API 的进程名 + 匹配类型 + 内容规则进行新增或复用。"
                                           Margin="0,12,0,0" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{StaticResource PimMutedTextBrush}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="2" Margin="2,10,2,0">
            <Button x:Name="DiscardStaleDraftButton" DockPanel.Dock="Right" Content="确认丢弃旧会话草稿"
                    Visibility="Collapsed" Style="{StaticResource PimSecondaryButton}"
                    Click="OnDiscardStaleDraft" />
            <TextBlock x:Name="StateText" Text="等待读取" TextWrapping="Wrap" FontSize="12"
                       VerticalAlignment="Center" Foreground="{StaticResource PimMutedTextBrush}" />
        </DockPanel>
    </Grid>
</Window>
