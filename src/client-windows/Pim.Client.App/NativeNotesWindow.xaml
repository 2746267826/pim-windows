<Window x:Class="Pim.Client.App.NativeNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="笔记库" Height="820" Width="1440" MinHeight="680" MinWidth="1120"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PimMutedSurfaceBrush}"
        Loaded="OnLoaded" Closing="OnClosing" Closed="OnClosed">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource PimSurfaceBrush}" BorderBrush="{StaticResource PimBorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="我的笔记" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PimTextBrush}" />
                    <TextBlock Text="内容优先 · 离线保存 · 固定材料版本" Margin="0,4,0,12" FontSize="12" Foreground="{StaticResource PimMutedTextBrush}" />
                    <TextBox x:Name="SearchBox" Height="34" Padding="9,5" VerticalContentAlignment="Center"
                             TextChanged="OnSearchChanged" ToolTip="搜索标题和正文" />
                    <Button Content="＋ 新建笔记" Style="{StaticResource PimPrimaryButton}" Margin="0,10,0,12" Height="38" Click="OnNewNote" />
                </StackPanel>
                <ListBox x:Name="NotesList" BorderThickness="0" Background="Transparent"
                         SelectionChanged="OnNoteSelected" DisplayMemberPath="Title" />
            </DockPanel>
        </Border>
        <Border Grid.Column="2" Background="{StaticResource PimSurfaceBrush}" BorderBrush="{StaticResource PimBorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                <RowDefinition Height="130" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="RecordButton" Content="● 开始录音" Style="{StaticResource PimPrimaryButton}" Margin="4,0" Click="OnToggleRecording" />
                        <Button x:Name="AddPhotoButton" Content="添加照片" Style="{StaticResource PimSecondaryButton}" Margin="4,0" Click="OnAddPhoto" />
                        <Button x:Name="AddHandwritingButton" Content="手写" Style="{StaticResource PimSecondaryButton}" Margin="4,0" Click="OnAddHandwriting" />
                        <Button x:Name="AddRecordingButton" Content="添加音频" Style="{StaticResource PimSecondaryButton}" Margin="4,0" Click="OnAddRecording" />
                        <Button Content="导入笔记包" Style="{StaticResource PimSecondaryButton}" Margin="4,0" Click="OnImportPackage" />
                        <Button Content="导出固定版本" Style="{StaticResource PimSecondaryButton}" Margin="4,0" Click="OnExport" />
                    </StackPanel>
                    <TextBox x:Name="TitleBox" FontSize="25" FontWeight="SemiBold" BorderThickness="0"
                             Padding="0,0,8,8" TextChanged="OnEditorChanged" />
                </DockPanel>
                <TextBlock Grid.Row="1" Text="Markdown 正文" FontSize="12" Foreground="{StaticResource PimMutedTextBrush}"
                           Margin="0,0,0,8" />
                <TextBox x:Name="MarkdownBox" Grid.Row="2" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         FontFamily="Consolas" FontSize="15" Padding="16" BorderBrush="{StaticResource PimBorderBrush}"
                         TextChanged="OnEditorChanged" />
                <DockPanel Grid.Row="3" Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Content="编辑所选笔迹"
                            Style="{StaticResource PimSecondaryButton}" Margin="6,0,0,4"
                            Click="OnEditHandwriting" />
                    <TextBlock DockPanel.Dock="Top" Text="当前固定版本中的材料（双击照片预览或音频回放）" FontSize="12"
                               Foreground="{StaticResource PimMutedTextBrush}" Margin="0,0,0,4" />
                    <ListBox x:Name="MaterialsList" BorderBrush="{StaticResource PimBorderBrush}"
                             DisplayMemberPath="DisplayName" MouseDoubleClick="OnMaterialDoubleClick" />
                </DockPanel>
                <DockPanel Grid.Row="4" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="MaterialsText" Text="固定材料版本 · 尚无材料" VerticalAlignment="Center"
                               Foreground="{StaticResource PimMutedTextBrush}" />
                        <TextBlock x:Name="RecordingStatusText" Margin="14,0,0,0" Text="" VerticalAlignment="Center"
                                   Foreground="{StaticResource PimActivityBrush}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ComboBox x:Name="VersionsBox" Width="220" Margin="0,0,6,0"
                                  DisplayMemberPath="Label" ToolTip="选择要查看或恢复的固定版本" />
                        <Button Content="恢复所选版本" Style="{StaticResource PimSecondaryButton}"
                                Margin="0,0,8,0" Click="OnRestoreVersion" />
                        <TextBlock x:Name="SaveStateText" Text="本机保存就绪" VerticalAlignment="Center"
                                   Foreground="{StaticResource PimMutedTextBrush}" />
                    </StackPanel>
                </DockPanel>
                </Grid>
                <Border Grid.Column="2" Background="{StaticResource PimMutedSurfaceBrush}"
                        BorderBrush="{StaticResource PimBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="170" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="110" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="云端固定版本与结果" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource PimTextBrush}" />
                        <TextBlock x:Name="CloudStatusText" Grid.Row="1" Margin="0,5,0,10"
                                   Text="登录后可上传固定版本并读取云端结果。"
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource PimMutedTextBrush}" />
                        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                            <Button Content="上传当前版本" Style="{StaticResource PimPrimaryButton}"
                                    Margin="0,0,6,6" Click="OnUploadCloudVersion" />
                            <Button Content="刷新云端" Style="{StaticResource PimSecondaryButton}"
                                    Margin="0,0,6,6" Click="OnRefreshCloud" />
                            <Button Content="服务器目录" Style="{StaticResource PimSecondaryButton}"
                                    Margin="0,0,6,6" Click="OnOpenCloudSources" />
                        </WrapPanel>
                        <DockPanel Grid.Row="3">
                            <TextBlock DockPanel.Dock="Top" Text="服务器固定材料版本"
                                       Foreground="{StaticResource PimMutedTextBrush}" FontSize="12"
                                       Margin="0,0,0,4" />
                            <ListBox x:Name="CloudVersionsList" BorderBrush="{StaticResource PimBorderBrush}"
                                     DisplayMemberPath="Label" SelectionChanged="OnCloudVersionSelected" />
                        </DockPanel>
                        <Button x:Name="PromoteCloudVersionButton" Grid.Row="4" Content="设为云端当前版本"
                                Style="{StaticResource PimSecondaryButton}" Margin="0,8,0,10"
                                Click="OnPromoteCloudVersion" />
                        <DockPanel Grid.Row="5">
                            <TextBlock DockPanel.Dock="Left" Text="云端记录与分析"
                                       Foreground="{StaticResource PimTextBrush}" FontWeight="SemiBold" />
                            <Button DockPanel.Dock="Right" Content="刷新结果"
                                    Style="{StaticResource PimSecondaryButton}"
                                    Padding="9,3" Click="OnRefreshCloudResults" />
                        </DockPanel>
                        <ListBox x:Name="CloudArtifactsList" Grid.Row="6" Margin="0,6,0,8"
                                 BorderBrush="{StaticResource PimBorderBrush}"
                                 DisplayMemberPath="Label" SelectionChanged="OnCloudArtifactSelected" />
                        <WrapPanel Grid.Row="7" Margin="0,0,0,6">
                            <Button Content="保存人工修订" Style="{StaticResource PimSecondaryButton}"
                                    Margin="0,0,6,6" Click="OnSaveCloudRevision" />
                            <Button Content="设为结果当前版本" Style="{StaticResource PimSecondaryButton}"
                                    Margin="0,0,6,6" Click="OnSelectCloudResultVersion" />
                            <Button Content="从此版本提取任务建议" Style="{StaticResource PimPrimaryButton}"
                                    Margin="0,0,6,6" Click="OnOpenTaskSuggestions" />
                        </WrapPanel>
                        <TextBox x:Name="CloudResultBox" Grid.Row="8" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="13" Padding="10"
                                 BorderBrush="{StaticResource PimBorderBrush}"
                                 TextChanged="OnCloudResultEdited"
                                 Text="云端结果会显示在这里。只读预览不会启动新的 ASR 或模型任务。" />
                        <TextBlock x:Name="CloudResultStateText" Grid.Row="9" Margin="0,6,0,0"
                                   Text="未选择结果版本" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource PimMutedTextBrush}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
