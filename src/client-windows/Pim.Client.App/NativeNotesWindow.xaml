<Window x:Class="Pim.Client.App.NativeNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="笔记库" Height="760" Width="1180" MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PimMutedSurfaceBrush}"
        Loaded="OnLoaded" Closing="OnClosing" Closed="OnClosed">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource PimSurfaceBrush}" BorderBrush="{StaticResource PimBorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="我的笔记" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PimTextBrush}" />
                    <TextBlock Text="内容优先 · 离线保存 · 固定材料版本" Margin="0,4,0,12" FontSize="12" Foreground="{StaticResource PimMutedTextBrush}" />
                    <TextBox x:Name="SearchBox" Height="34" Padding="9,5" VerticalContentAlignment="Center"
                             TextChanged="OnSearchChanged" ToolTip="搜索标题和正文" />
                    <Button Content="＋ 新建笔记" Style="{StaticResource PimPrimaryButton}" Margin="0,10,0,12" Height="38" Click="OnNewNote" />
                </StackPanel>
                <ListBox x:Name="NotesList" BorderThickness="0" Background="Transparent"
                         SelectionChanged="OnNoteSelected" DisplayMemberPath="Title" />
            </DockPanel>
        </Border>
        <Border Grid.Column="2" Background="{StaticResource PimSurfaceBrush}" BorderBrush="{StaticResource PimBorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                <RowDefinition Height="130" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="RecordButton" Content="● 开始录音" Style="{StaticResource PimPrimaryButton}" Margin="4,0" Click="OnToggleRecording" />
                        <Button Content="添加照片" Style="{StaticResource PimSecondaryButton}" Margin="4,0" Click="OnAddPhoto" />
                        <Button Content="手写" Style="{StaticResource PimSecondaryButton}" Margin="4,0" Click="OnAddHandwriting" />
                        <Button Content="添加音频" Style="{StaticResource PimSecondaryButton}" Margin="4,0" Click="OnAddRecording" />
                        <Button Content="导入笔记包" Style="{StaticResource PimSecondaryButton}" Margin="4,0" Click="OnImportPackage" />
                        <Button Content="导出固定版本" Style="{StaticResource PimSecondaryButton}" Margin="4,0" Click="OnExport" />
                    </StackPanel>
                    <TextBox x:Name="TitleBox" FontSize="25" FontWeight="SemiBold" BorderThickness="0"
                             Padding="0,0,8,8" TextChanged="OnEditorChanged" />
                </DockPanel>
                <TextBlock Grid.Row="1" Text="Markdown 正文" FontSize="12" Foreground="{StaticResource PimMutedTextBrush}"
                           Margin="0,0,0,8" />
                <TextBox x:Name="MarkdownBox" Grid.Row="2" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         FontFamily="Consolas" FontSize="15" Padding="16" BorderBrush="{StaticResource PimBorderBrush}"
                         TextChanged="OnEditorChanged" />
                <DockPanel Grid.Row="3" Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="当前固定版本中的材料（双击照片预览或音频回放）" FontSize="12"
                               Foreground="{StaticResource PimMutedTextBrush}" Margin="0,0,0,4" />
                    <ListBox x:Name="MaterialsList" BorderBrush="{StaticResource PimBorderBrush}"
                             DisplayMemberPath="DisplayName" MouseDoubleClick="OnMaterialDoubleClick" />
                </DockPanel>
                <DockPanel Grid.Row="4" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="MaterialsText" Text="固定材料版本 · 尚无材料" VerticalAlignment="Center"
                               Foreground="{StaticResource PimMutedTextBrush}" />
                        <TextBlock x:Name="RecordingStatusText" Margin="14,0,0,0" Text="" VerticalAlignment="Center"
                                   Foreground="{StaticResource PimActivityBrush}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ComboBox x:Name="VersionsBox" Width="220" Margin="0,0,6,0"
                                  DisplayMemberPath="Label" ToolTip="选择要查看或恢复的固定版本" />
                        <Button Content="恢复所选版本" Style="{StaticResource PimSecondaryButton}"
                                Margin="0,0,8,0" Click="OnRestoreVersion" />
                        <TextBlock x:Name="SaveStateText" Text="本机保存就绪" VerticalAlignment="Center"
                                   Foreground="{StaticResource PimMutedTextBrush}" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
