<Window x:Class="Pim.Client.App.NativeNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="笔记库" Height="900" Width="1380" MinHeight="620" MinWidth="760"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PimMutedSurfaceBrush}"
        Loaded="OnLoaded" Closing="OnClosing" Closed="OnClosed"
        SizeChanged="OnWindowSizeChanged" PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PimSurfaceBrush}"
                BorderBrush="{StaticResource PimBorderBrush}" BorderThickness="0,0,0,1"
                Padding="18,10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SyncStatusText" Text="同步：未选择笔记" FontSize="12"
                               Margin="0,0,16,0" VerticalAlignment="Center"
                               ToolTip="顶部只显示最近一次真实本机/云端结果"
                               Foreground="{StaticResource PimMutedTextBrush}" />
                    <Button Content="笔记" Style="{StaticResource PimSecondaryButton}"
                            Margin="0,0,6,0" Padding="11,5"
                            ToolTip="打开笔记侧栏 (Ctrl+Alt+B)"
                            Click="OnShowNotesSidebar" />
                    <Button Content="材料" Style="{StaticResource PimSecondaryButton}"
                            Margin="0,0,6,0" Padding="11,5"
                            ToolTip="打开本篇材料侧栏 (Ctrl+Alt+M)"
                            Click="OnShowMaterialsSidebar" />
                    <Button x:Name="MoreButton" Style="{StaticResource PimSecondaryButton}"
                            Padding="0" Click="OnMoreMenuClick">
                        <Grid>
                            <TextBlock Text="更多" Margin="11,5" />
                            <Border x:Name="MoreButtonBusyBadge" Width="7" Height="7"
                                    CornerRadius="4" Background="{StaticResource PimWarningBrush}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,2,2,0" Visibility="Collapsed" />
                        </Grid>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="导入笔记包" Click="OnImportPackage" />
                                <MenuItem Header="导出固定版本" Click="OnExport" />
                                <Separator />
                                <MenuItem Header="上传记录与云端版本" Click="OnOpenUploadRecords" />
                                <MenuItem Header="上传当前版本" Click="OnUploadCloudVersion" />
                                <MenuItem Header="刷新云端版本" Click="OnRefreshCloud" />
                                <MenuItem Header="服务器目录" Click="OnOpenCloudSources" />
                                <Separator />
                                <MenuItem Header="收起/展开侧栏" InputGestureText="Ctrl+Alt+B"
                                          Click="OnToggleSidebar" />
                                <MenuItem Header="恢复默认侧栏宽度" InputGestureText="Ctrl+Alt+0"
                                          Click="OnResetWorkspaceLayout" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <TextBlock Text="笔记库" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{StaticResource PimTextBrush}" />
            </DockPanel>
        </Border>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1" Margin="18,12,18,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="360" />
                <ColumnDefinition x:Name="SplitterColumn" Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SidebarOverlayScrim" Grid.Column="0" Grid.ColumnSpan="3"
                    Background="#330F172A" Visibility="Collapsed" Panel.ZIndex="9"
                    MouseLeftButtonDown="OnOverlayScrimMouseDown"
                    MouseDown="OnOverlayScrimMouseDown" />

            <Border x:Name="SidebarPanel" Grid.Column="0" Background="{StaticResource PimSurfaceBrush}"
                    BorderBrush="{StaticResource PimBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="12" Panel.ZIndex="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="True" Margin="0,0,0,10">
                        <Button x:Name="CollapseSidebarButton" DockPanel.Dock="Right"
                                Content="‹" Style="{StaticResource PimSecondaryButton}"
                                Padding="10,3" ToolTip="收起侧栏 (Ctrl+Alt+B)"
                                Click="OnToggleSidebar" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="NotesPaneButton" Content="笔记"
                                    Style="{StaticResource PimSecondaryButton}"
                                    Padding="12,5" Margin="0,0,4,0" Click="OnShowNotesPane" />
                            <Button x:Name="MaterialsPaneButton" Content="本篇材料"
                                    Style="{StaticResource PimSecondaryButton}"
                                    Padding="12,5" Click="OnShowMaterialsPane" />
                        </StackPanel>
                    </DockPanel>

                    <Grid x:Name="NotesPane" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBox x:Name="SearchBox" Height="34" Padding="9,5"
                                     VerticalContentAlignment="Center"
                                     TextChanged="OnSearchChanged" ToolTip="搜索标题和正文" />
                            <Button Content="＋ 新建笔记" Style="{StaticResource PimPrimaryButton}"
                                    Margin="0,8,0,10" Height="38" Click="OnNewNote" />
                        </StackPanel>
                        <ListBox x:Name="NotesList" Grid.Row="1" BorderThickness="0"
                                 Background="Transparent" SelectionChanged="OnNoteSelected"
                                 DisplayMemberPath="Title" />
                    </Grid>

                    <ScrollViewer x:Name="MaterialsPane" Grid.Row="1" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock x:Name="MaterialsText" Text="未选择笔记" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,0,0,6"
                                       Foreground="{StaticResource PimMutedTextBrush}" />
                            <ListBox x:Name="MaterialsList" Height="150"
                                     BorderBrush="{StaticResource PimBorderBrush}"
                                     DisplayMemberPath="DisplayName"
                                     ToolTip="双击打开材料"
                                     MouseDoubleClick="OnMaterialDoubleClick" />
                            <Button Content="编辑所选笔迹" Style="{StaticResource PimSecondaryButton}"
                                    Margin="0,6,0,12" Click="OnEditHandwriting" />

                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="固定版本" VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           Foreground="{StaticResource PimMutedTextBrush}" />
                                <Button DockPanel.Dock="Right" Content="恢复"
                                        Style="{StaticResource PimSecondaryButton}"
                                        Padding="10,4" Margin="6,0,0,0"
                                        Click="OnRestoreVersion" />
                                <ComboBox x:Name="VersionsBox" MinWidth="120"
                                          DisplayMemberPath="Label"
                                          ToolTip="选择要查看或恢复的固定版本" />
                            </DockPanel>

                            <Expander x:Name="UploadRecordsExpander"
                                      Header="更多：上传记录与云端版本"
                                      IsExpanded="False" Margin="0,0,0,8">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock x:Name="CloudStatusText" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,0,0,6"
                                               Foreground="{StaticResource PimMutedTextBrush}" />
                                    <ListBox x:Name="CloudVersionsList" Height="130"
                                             BorderBrush="{StaticResource PimBorderBrush}"
                                             DisplayMemberPath="Label"
                                             SelectionChanged="OnCloudVersionSelected" />
                                    <Button x:Name="PromoteCloudVersionButton" Content="设为云端当前版本"
                                            Style="{StaticResource PimSecondaryButton}"
                                            Margin="0,6,0,0" Click="OnPromoteCloudVersion" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="服务端处理状态" IsExpanded="True" Margin="0,0,0,8">
                                <Border Background="{StaticResource PimMutedSurfaceBrush}"
                                        BorderBrush="{StaticResource PimBorderBrush}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="10" Margin="0,6,0,0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <Button x:Name="RefreshProcessingStatusButton"
                                                    DockPanel.Dock="Right" Content="刷新"
                                                    Style="{StaticResource PimSecondaryButton}"
                                                    Padding="9,3"
                                                    Click="OnRefreshProcessingStatus" />
                                            <TextBlock Text="处理状态" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource PimTextBrush}" />
                                        </DockPanel>
                                        <TextBlock x:Name="ProcessingTargetText" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,0,0,3"
                                                   Foreground="{StaticResource PimMutedTextBrush}" />
                                        <TextBlock x:Name="ProcessingOverallText" FontSize="12"
                                                   TextWrapping="Wrap" Text="未选择笔记"
                                                   Foreground="{StaticResource PimTextBrush}" />
                                        <TextBlock x:Name="ProcessingAsrText" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Foreground="{StaticResource PimMutedTextBrush}" />
                                        <TextBlock x:Name="ProcessingDerivedText" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Foreground="{StaticResource PimMutedTextBrush}" />
                                        <TextBlock x:Name="ProcessingArtifactsText" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Foreground="{StaticResource PimMutedTextBrush}" />
                                        <TextBlock x:Name="ProcessingHintText" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,5,0,0"
                                                   Foreground="{StaticResource PimMutedTextBrush}" />
                                        <TextBlock x:Name="ProcessingIssuesText" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="Collapsed"
                                                   Foreground="{StaticResource PimActivityBrush}" />
                                        <TextBlock x:Name="ProcessingUpdatedText" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Foreground="{StaticResource PimMutedTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <Expander Header="云端结果" IsExpanded="False" Margin="0,0,0,8">
                                <StackPanel Margin="0,6,0,0">
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="刷新结果"
                                                Style="{StaticResource PimSecondaryButton}"
                                                Padding="9,3" Click="OnRefreshCloudResults" />
                                        <TextBlock Text="记录与分析" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource PimTextBrush}" />
                                    </DockPanel>
                                    <ListBox x:Name="CloudArtifactsList" Height="100"
                                             BorderBrush="{StaticResource PimBorderBrush}"
                                             DisplayMemberPath="Label"
                                             SelectionChanged="OnCloudArtifactSelected" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button Content="保存人工修订"
                                                Style="{StaticResource PimSecondaryButton}"
                                                Margin="0,0,4,4" Click="OnSaveCloudRevision" />
                                        <Button Content="设为结果当前版本"
                                                Style="{StaticResource PimSecondaryButton}"
                                                Margin="0,0,4,4" Click="OnSelectCloudResultVersion" />
                                        <Button Content="提取任务建议"
                                                Style="{StaticResource PimPrimaryButton}"
                                                Margin="0,0,4,4" Click="OnOpenTaskSuggestions" />
                                    </WrapPanel>
                                    <TextBox x:Name="CloudResultBox" Height="180" AcceptsReturn="True"
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             FontFamily="Consolas" FontSize="13" Padding="10"
                                             BorderBrush="{StaticResource PimBorderBrush}"
                                             TextChanged="OnCloudResultEdited" />
                                    <TextBlock x:Name="CloudResultStateText" Margin="0,6,0,0"
                                               TextWrapping="Wrap" FontSize="12"
                                               Foreground="{StaticResource PimMutedTextBrush}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Width="6" ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" ShowsPreview="True"
                          Background="Transparent"
                          ToolTip="拖动调整侧栏宽度；Ctrl+Alt+←/→ 调整，Ctrl+Alt+0 恢复默认"
                          DragCompleted="OnSidebarSplitterDragCompleted" />

            <Border x:Name="EditorPanel" Grid.Column="2"
                    Background="{StaticResource PimSurfaceBrush}"
                    BorderBrush="{StaticResource PimBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="TitleBox" Grid.Row="0" FontSize="25" FontWeight="SemiBold"
                             BorderThickness="0" Padding="0,0,8,8"
                             TextChanged="OnEditorChanged" />
                    <WrapPanel Grid.Row="1" Margin="0,2,0,10">
                        <Button x:Name="RecordButton" Content="● 开始录音"
                                Style="{StaticResource PimPrimaryButton}"
                                Margin="0,0,6,6" Click="OnToggleRecording" />
                        <Button x:Name="AddPhotoButton" Content="添加照片"
                                Style="{StaticResource PimSecondaryButton}"
                                Margin="0,0,6,6" Click="OnAddPhoto" />
                        <Button x:Name="AddHandwritingButton" Content="手写"
                                Style="{StaticResource PimSecondaryButton}"
                                Margin="0,0,6,6" Click="OnAddHandwriting" />
                        <Button x:Name="AddRecordingButton" Content="添加音频"
                                Style="{StaticResource PimSecondaryButton}"
                                Margin="0,0,6,6" Click="OnAddRecording" />
                        <Button x:Name="EditorCollapseSidebarButton" Content="收起侧栏"
                                Style="{StaticResource PimSecondaryButton}"
                                Margin="0,0,6,6" Visibility="Collapsed"
                                Click="OnToggleSidebar" />
                    </WrapPanel>
                    <TextBox x:Name="MarkdownBox" Grid.Row="2" AcceptsReturn="True"
                             AcceptsTab="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             FontFamily="Consolas" FontSize="15" Padding="16"
                             BorderBrush="{StaticResource PimBorderBrush}"
                             TextChanged="OnEditorChanged" />
                    <DockPanel Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock x:Name="SaveStateText" DockPanel.Dock="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource PimMutedTextBrush}" />
                        <TextBlock x:Name="RecordingStatusText" VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource PimActivityBrush}" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
