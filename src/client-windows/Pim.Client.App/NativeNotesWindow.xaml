<Window x:Class="Pim.Client.App.NativeNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="笔记库" Height="840" Width="1480" MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PimMutedSurfaceBrush}"
        Loaded="OnLoaded" Closing="OnClosing" Closed="OnClosed">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="296" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PimSurfaceBrush}"
                BorderBrush="{StaticResource PimBorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="我的笔记" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource PimTextBrush}" />
                    <TextBlock Text="内容优先 · 离线保存 · 固定材料版本" Margin="0,4,0,12"
                               FontSize="12" Foreground="{StaticResource PimMutedTextBrush}" />
                    <TextBox x:Name="SearchBox" Height="34" Padding="9,5"
                             VerticalContentAlignment="Center" TextChanged="OnSearchChanged"
                             ToolTip="搜索标题和正文" />
                    <Button Content="＋ 新建笔记" Style="{StaticResource PimPrimaryButton}"
                            Margin="0,10,0,10" Height="38" Click="OnNewNote" />
                </StackPanel>

                <Grid>
                    <ListBox x:Name="NotesList" BorderThickness="0" Background="Transparent"
                             SelectionChanged="OnNoteSelected" DisplayMemberPath="Title" />
                    <Border x:Name="NotesStatePanel" Background="{StaticResource PimSurfaceBrush}"
                            BorderBrush="{StaticResource PimBorderBrush}" BorderThickness="1"
                            CornerRadius="9" Padding="18" Visibility="Visible">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="NotesStateIconText" Text="✎" FontSize="34"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource PimPrimaryBrush}" />
                            <TextBlock x:Name="NotesStateTitleText" Text="正在读取本机笔记…"
                                       Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource PimTextBrush}" />
                            <TextBlock x:Name="NotesStateDetailText"
                                       Text="笔记与原始材料只保存在这台电脑上。"
                                       Margin="0,6,0,0" FontSize="12" TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource PimMutedTextBrush}" />
                            <ProgressBar x:Name="NotesLoadingBar" IsIndeterminate="True"
                                         Height="4" Margin="0,16,0,0" Visibility="Visible" />
                            <Button x:Name="NotesStateCreateButton" Content="＋ 新建笔记"
                                    Style="{StaticResource PimPrimaryButton}" Margin="0,16,0,0"
                                    HorizontalAlignment="Center" Visibility="Collapsed"
                                    Click="OnNewNote" />
                            <Button x:Name="NotesStateClearSearchButton" Content="清空搜索"
                                    Style="{StaticResource PimSecondaryButton}" Margin="0,16,0,0"
                                    HorizontalAlignment="Center" Visibility="Collapsed"
                                    Click="OnClearSearch" />
                            <Button x:Name="NotesStateRetryButton" Content="重试读取"
                                    Style="{StaticResource PimSecondaryButton}" Margin="0,16,0,0"
                                    HorizontalAlignment="Center" Visibility="Collapsed"
                                    Click="OnRetryNotes" />
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Background="{StaticResource PimSurfaceBrush}"
                BorderBrush="{StaticResource PimBorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="EditorContextText" Text="选择一篇笔记"
                                   FontSize="12" Foreground="{StaticResource PimMutedTextBrush}" />
                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock x:Name="SaveStateText" Text=""
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource PimMutedTextBrush}" />
                            <TextBlock x:Name="RecordingStatusText" Text="" Margin="14,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource PimActivityBrush}" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="CloudPanelToggleButton" Content="版本与云端"
                                Style="{StaticResource PimSecondaryButton}" Height="36"
                                Margin="0,0,8,0" IsEnabled="False"
                                Click="OnToggleCloudPanel" />
                        <Button x:Name="FinishButton" Content="结束"
                                Style="{StaticResource PimPrimaryButton}" MinWidth="82"
                                Height="36" FontWeight="SemiBold" IsEnabled="False"
                                Click="OnFinishNote">
                            <Button.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.18"
                                                  BlurRadius="12" ShadowDepth="2"
                                                  Direction="270" />
                            </Button.Effect>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border x:Name="EditorNoticePanel" Grid.Row="1" Margin="0,0,0,10"
                        Padding="12,9" CornerRadius="8"
                        Background="{StaticResource PimMutedSurfaceBrush}"
                        BorderBrush="{StaticResource PimDangerBrush}"
                        BorderThickness="1" Visibility="Collapsed">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="RetryNoticeButton" Content="重试"
                                    Style="{StaticResource PimSecondaryButton}"
                                    Padding="10,5" Margin="0,0,6,0" Visibility="Collapsed"
                                    Click="OnRetryNotice" />
                            <Button x:Name="NoticeDismissButton" Content="关闭"
                                    Style="{StaticResource PimSecondaryButton}"
                                    Padding="10,5" Click="OnDismissNotice" />
                        </StackPanel>
                        <TextBlock x:Name="EditorNoticeText" Text="" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Foreground="{StaticResource PimDangerBrush}" />
                    </DockPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <ScrollViewer x:Name="DocumentScroll" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,10,0">
                            <StackPanel Margin="26,8,18,44">
                                <TextBox x:Name="TitleBox" FontFamily="Microsoft YaHei UI, Segoe UI"
                                         FontSize="30" FontWeight="SemiBold" BorderThickness="0"
                                         Background="Transparent" Padding="0,0,8,10"
                                         TextChanged="OnEditorChanged" />

                                <WrapPanel Margin="0,0,0,18">
                                    <Button x:Name="RecordButton" Content="● 开始录音"
                                            Style="{StaticResource PimPrimaryButton}"
                                            Margin="0,0,6,6" Click="OnToggleRecording" />
                                    <Button x:Name="AddPhotoButton" Content="添加照片"
                                            Style="{StaticResource PimSecondaryButton}"
                                            Margin="0,0,6,6" Click="OnAddPhoto" />
                                    <Button x:Name="AddHandwritingButton" Content="手写"
                                            Style="{StaticResource PimSecondaryButton}"
                                            Margin="0,0,6,6" Click="OnAddHandwriting" />
                                    <Button x:Name="AddRecordingButton" Content="添加音频"
                                            Style="{StaticResource PimSecondaryButton}"
                                            Margin="0,0,6,6" Click="OnAddRecording" />
                                    <Button Content="导入笔记包"
                                            Style="{StaticResource PimSecondaryButton}"
                                            Margin="0,0,6,6" Click="OnImportPackage" />
                                    <Button Content="导出固定版本"
                                            Style="{StaticResource PimSecondaryButton}"
                                            Margin="0,0,6,6" Click="OnExport" />
                                </WrapPanel>

                                <Border BorderBrush="{StaticResource PimBorderBrush}"
                                        BorderThickness="0,1,0,0" Padding="0,16,0,0" />
                                <TextBlock Text="Markdown 正文" FontSize="12"
                                           Foreground="{StaticResource PimMutedTextBrush}"
                                           Margin="0,0,0,8" />
                                <TextBox x:Name="MarkdownBox" AcceptsReturn="True" AcceptsTab="True"
                                         TextWrapping="Wrap" MinHeight="360"
                                         VerticalScrollBarVisibility="Disabled"
                                         HorizontalScrollBarVisibility="Disabled"
                                         FontFamily="Microsoft YaHei UI, Segoe UI"
                                         FontSize="16" Padding="0" BorderThickness="0"
                                         Background="Transparent"
                                         VerticalContentAlignment="Top"
                                         TextChanged="OnEditorChanged" />

                                <Expander Header="本机固定材料" IsExpanded="True"
                                          Margin="0,24,0,0">
                                    <Grid Margin="0,8,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="MaterialsText"
                                                       Text="固定材料版本 · 尚无材料"
                                                       Foreground="{StaticResource PimMutedTextBrush}"
                                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="编辑所选笔迹"
                                                    Style="{StaticResource PimSecondaryButton}"
                                                    Margin="8,0,0,0" Click="OnEditHandwriting" />
                                        </Grid>
                                        <ListBox x:Name="MaterialsList" Grid.Row="1" Height="160"
                                                 Margin="0,8,0,0"
                                                 BorderBrush="{StaticResource PimBorderBrush}"
                                                 DisplayMemberPath="DisplayName"
                                                 ToolTip="双击照片预览或音频回放"
                                                 MouseDoubleClick="OnMaterialDoubleClick" />
                                    </Grid>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel x:Name="EditorStatePanel" VerticalAlignment="Center"
                                    HorizontalAlignment="Center" MaxWidth="420"
                                    Visibility="Visible">
                            <ProgressBar x:Name="EditorStateProgress" IsIndeterminate="True"
                                         Width="220" Height="4" Margin="0,0,0,18"
                                         Visibility="Visible" />
                            <TextBlock x:Name="EditorStateTitleText" Text="正在准备笔记库…"
                                       FontSize="22" FontWeight="SemiBold"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource PimTextBrush}" />
                            <TextBlock x:Name="EditorStateDetailText"
                                       Text="正文、照片、手写和录音先保存在本机。"
                                       Margin="0,8,0,0" FontSize="13" TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource PimMutedTextBrush}" />
                            <Button x:Name="EditorStateCreateButton" Content="＋ 新建笔记"
                                    Style="{StaticResource PimPrimaryButton}" Margin="0,18,0,0"
                                    HorizontalAlignment="Center" Visibility="Collapsed"
                                    Click="OnNewNote" />
                            <Button x:Name="EditorStateRetryButton" Content="重试"
                                    Style="{StaticResource PimSecondaryButton}" Margin="0,18,0,0"
                                    HorizontalAlignment="Center" Visibility="Collapsed"
                                    Click="OnRetryEditorState" />
                        </StackPanel>
                    </Grid>

                    <Border x:Name="CloudPanel" Grid.Column="1" Width="360" Margin="16,0,0,0"
                            Background="{StaticResource PimMutedSurfaceBrush}"
                            BorderBrush="{StaticResource PimBorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="14" Visibility="Collapsed">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="收起"
                                        Style="{StaticResource PimSecondaryButton}"
                                        Padding="9,4" Click="OnToggleCloudPanel" />
                                <TextBlock Text="版本与云端" FontSize="18" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource PimTextBrush}" />
                            </DockPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="本机固定版本" FontWeight="SemiBold"
                                               Foreground="{StaticResource PimTextBrush}" />
                                    <ComboBox x:Name="VersionsBox" Margin="0,7,0,7"
                                              DisplayMemberPath="Label"
                                              ToolTip="选择要查看或恢复的固定版本" />
                                    <Button Content="恢复所选版本"
                                            Style="{StaticResource PimSecondaryButton}"
                                            HorizontalAlignment="Left"
                                            Click="OnRestoreVersion" />

                                    <Border BorderBrush="{StaticResource PimBorderBrush}"
                                            BorderThickness="0,1,0,0" Margin="0,14,0,12" />

                                    <TextBlock Text="云端固定版本与结果" FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PimTextBrush}" />
                                    <TextBlock x:Name="CloudStatusText" Margin="0,5,0,10"
                                               Text="登录后可上传固定版本并读取云端结果。"
                                               TextWrapping="Wrap" FontSize="12"
                                               Foreground="{StaticResource PimMutedTextBrush}" />
                                    <WrapPanel Margin="0,0,0,8">
                                        <Button Content="上传当前版本"
                                                Style="{StaticResource PimPrimaryButton}"
                                                Margin="0,0,6,6" Click="OnUploadCloudVersion" />
                                        <Button Content="刷新云端"
                                                Style="{StaticResource PimSecondaryButton}"
                                                Margin="0,0,6,6" Click="OnRefreshCloud" />
                                        <Button Content="服务器目录"
                                                Style="{StaticResource PimSecondaryButton}"
                                                Margin="0,0,6,6" Click="OnOpenCloudSources" />
                                    </WrapPanel>
                                    <TextBlock Text="服务器固定材料版本"
                                               Foreground="{StaticResource PimMutedTextBrush}"
                                               FontSize="12" Margin="0,0,0,4" />
                                    <ListBox x:Name="CloudVersionsList" Height="150"
                                             BorderBrush="{StaticResource PimBorderBrush}"
                                             DisplayMemberPath="Label"
                                             SelectionChanged="OnCloudVersionSelected" />
                                    <Button x:Name="PromoteCloudVersionButton"
                                            Content="设为云端当前版本"
                                            Style="{StaticResource PimSecondaryButton}"
                                            Margin="0,8,0,10"
                                            Click="OnPromoteCloudVersion" />
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock DockPanel.Dock="Left" Text="云端记录与分析"
                                                   Foreground="{StaticResource PimTextBrush}"
                                                   FontWeight="SemiBold" />
                                        <Button DockPanel.Dock="Right" Content="刷新结果"
                                                Style="{StaticResource PimSecondaryButton}"
                                                Padding="9,3"
                                                Click="OnRefreshCloudResults" />
                                    </DockPanel>
                                    <ListBox x:Name="CloudArtifactsList" Height="130"
                                             Margin="0,6,0,8"
                                             BorderBrush="{StaticResource PimBorderBrush}"
                                             DisplayMemberPath="Label"
                                             SelectionChanged="OnCloudArtifactSelected" />
                                    <WrapPanel Margin="0,0,0,6">
                                        <Button Content="保存人工修订"
                                                Style="{StaticResource PimSecondaryButton}"
                                                Margin="0,0,6,6"
                                                Click="OnSaveCloudRevision" />
                                        <Button Content="设为结果当前版本"
                                                Style="{StaticResource PimSecondaryButton}"
                                                Margin="0,0,6,6"
                                                Click="OnSelectCloudResultVersion" />
                                        <Button Content="从此版本提取任务建议"
                                                Style="{StaticResource PimPrimaryButton}"
                                                Margin="0,0,6,6"
                                                Click="OnOpenTaskSuggestions" />
                                    </WrapPanel>
                                    <TextBox x:Name="CloudResultBox" Height="180"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             FontFamily="Microsoft YaHei UI, Segoe UI"
                                             FontSize="13" Padding="10"
                                             BorderBrush="{StaticResource PimBorderBrush}"
                                             TextChanged="OnCloudResultEdited"
                                             Text="云端结果会显示在这里。只读预览不会启动新的 ASR 或模型任务。" />
                                    <TextBlock x:Name="CloudResultStateText"
                                               Margin="0,6,0,0" Text="未选择结果版本"
                                               TextWrapping="Wrap" FontSize="12"
                                               Foreground="{StaticResource PimMutedTextBrush}" />
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
