<Window x:Class="Pim.Client.App.NoteTaskSuggestionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="从笔记生成任务" Height="780" Width="1320" MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PimMutedSurfaceBrush}"
        Loaded="OnLoaded" Closing="OnClosing" Closed="OnClosed">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="从固定笔记结果提取任务" FontSize="23" FontWeight="SemiBold"
                           Foreground="{StaticResource PimTextBrush}" />
                <TextBlock x:Name="SourceIdentityText" Margin="0,4,0,0" FontSize="12"
                           Foreground="{StaticResource PimMutedTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <DockPanel>
                    <Button x:Name="StartExtractionButton" DockPanel.Dock="Right"
                            Content="开始提取" Style="{StaticResource PimPrimaryButton}"
                            Margin="8,0,0,0" Click="OnStartExtraction" />
                    <ComboBox x:Name="DestinationBox" Height="36" DisplayMemberPath="DisplayName"
                              ToolTip="选择服务器已配置的文本模型" SelectionChanged="OnDestinationChanged" />
                </DockPanel>
                <TextBlock x:Name="DestinationDetailText" Margin="2,5,0,0" FontSize="11"
                           Foreground="{StaticResource PimMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                <DockPanel Margin="0,6,0,0">
                    <Button x:Name="RefreshExtractionButton" DockPanel.Dock="Right" Content="刷新提取或建议"
                            Style="{StaticResource PimSecondaryButton}" Padding="10,4"
                            Click="OnRefreshExtraction" IsEnabled="False" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="正在读取模型目录…"
                               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource PimMutedTextBrush}" />
                </DockPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PimSurfaceBrush}"
                    BorderBrush="{StaticResource PimBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="固定来源正文（只读）" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource PimTextBrush}" />
                    <TextBlock x:Name="SourceHashText" Grid.Row="1" Margin="0,4,0,8" FontSize="11"
                               Foreground="{StaticResource PimMutedTextBrush}" TextWrapping="Wrap" />
                    <TextBox x:Name="SourceTextBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="13" Padding="10"
                             BorderBrush="{StaticResource PimBorderBrush}" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PimSurfaceBrush}"
                    BorderBrush="{StaticResource PimBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="待处理建议" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource PimTextBrush}" />
                        <TextBlock x:Name="SuggestionListStateText" Margin="0,4,0,0" FontSize="11"
                                   Foreground="{StaticResource PimMutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListBox x:Name="SuggestionsList" BorderBrush="{StaticResource PimBorderBrush}"
                             SelectionChanged="OnSuggestionSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                               Foreground="{StaticResource PimTextBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" Margin="0,3,0,0" FontSize="11"
                                               Foreground="{StaticResource PimMutedTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="4" Background="{StaticResource PimSurfaceBrush}"
                    BorderBrush="{StaticResource PimBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="编辑任务建议" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource PimTextBrush}" />
                        <TextBlock x:Name="EditorStateText" Margin="0,4,0,12" FontSize="11"
                                   Foreground="{StaticResource PimMutedTextBrush}" TextWrapping="Wrap"
                                   Text="选择一条建议后，可编辑并保存，或明确确认写入任务本。" />

                        <TextBlock Text="标题" FontSize="12" Foreground="{StaticResource PimMutedTextBrush}" />
                        <TextBox x:Name="TitleBox" MaxLength="255" Height="36" Padding="8,5" Margin="0,4,0,10"
                                 TextChanged="OnEditorChanged" />

                        <TextBlock Text="说明" FontSize="12" Foreground="{StaticResource PimMutedTextBrush}" />
                        <TextBox x:Name="DescriptionBox" Height="112" Padding="8" Margin="0,4,0,10"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 TextChanged="OnEditorChanged" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="优先级" FontSize="12" Foreground="{StaticResource PimMutedTextBrush}" />
                                <ComboBox x:Name="PriorityBox" Height="34" Margin="0,4,0,0"
                                          SelectionChanged="OnEditorChoiceChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="截止日期" FontSize="12" Foreground="{StaticResource PimMutedTextBrush}" />
                                <DatePicker x:Name="DueDatePicker" Height="34" Margin="0,4,0,0"
                                            SelectedDateChanged="OnDueDateChanged" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="目标任务本" FontSize="12" Foreground="{StaticResource PimMutedTextBrush}" />
                        <ComboBox x:Name="TaskBookBox" Height="34" Margin="0,4,0,10"
                                  DisplayMemberPath="Label" SelectionChanged="OnEditorChoiceChanged" />
                        <TextBlock Text="目标日历（可选）" FontSize="12" Foreground="{StaticResource PimMutedTextBrush}" />
                        <ComboBox x:Name="CalendarBox" Height="34" Margin="0,4,0,14"
                                  DisplayMemberPath="Label" SelectionChanged="OnEditorChoiceChanged" />

                        <WrapPanel>
                            <Button x:Name="SaveEditButton" Content="保存修改" Style="{StaticResource PimPrimaryButton}"
                                    Margin="0,0,6,6" Click="OnSaveEdit" IsEnabled="False" />
                            <Button x:Name="ConfirmButton" Content="确认写入任务" Style="{StaticResource PimPrimaryButton}"
                                    Margin="0,0,6,6" Click="OnConfirm" IsEnabled="False" />
                            <Button x:Name="DismissButton" Content="放弃此建议" Style="{StaticResource PimSecondaryButton}"
                                    Margin="0,0,6,6" Click="OnDismiss" IsEnabled="False" />
                        </WrapPanel>
                        <Button x:Name="VerifyPendingButton" Content="核实待确认状态"
                                Style="{StaticResource PimSecondaryButton}" Margin="0,0,6,6"
                                Click="OnVerifyPending" IsEnabled="False" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
