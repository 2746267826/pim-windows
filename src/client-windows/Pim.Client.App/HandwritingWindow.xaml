<Window x:Class="Pim.Client.App.HandwritingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手写材料" Width="720" Height="560" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PimMutedSurfaceBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="清除" Style="{StaticResource PimSecondaryButton}" Margin="4,0" Click="OnClear" />
                <Button Content="保存手写" Style="{StaticResource PimPrimaryButton}" Margin="4,0" Click="OnSave" />
            </StackPanel>
            <TextBlock Text="手写卡片" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{StaticResource PimTextBrush}" />
        </DockPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource PimBorderBrush}" BorderThickness="1" CornerRadius="8">
            <InkCanvas x:Name="Canvas" Background="White" EditingMode="Ink" />
        </Border>
        <TextBlock Grid.Row="2" Margin="0,10,0,0" Text="保存时会同时保留可重放的笔迹坐标与用于 AI 输入的 PNG，不只保存截图。"
                   Foreground="{StaticResource PimMutedTextBrush}" />
    </Grid>
</Window>
