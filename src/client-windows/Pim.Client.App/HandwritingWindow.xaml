<Window x:Class="Pim.Client.App.HandwritingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手写材料" Width="720" Height="560" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PimMutedSurfaceBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="清除" Style="{StaticResource PimSecondaryButton}" Margin="4,0" Click="OnClear" />
                <Button x:Name="CancelButton" Content="取消" IsCancel="True" Style="{StaticResource PimSecondaryButton}" Margin="4,0" />
                <Button x:Name="SaveButton" Content="保存手写" Style="{StaticResource PimPrimaryButton}" Margin="4,0" Click="OnSave" />
            </StackPanel>
            <TextBlock x:Name="HandwritingTitle" Text="手写卡片" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{StaticResource PimTextBrush}" />
        </DockPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource PimBorderBrush}" BorderThickness="1" CornerRadius="8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <InkCanvas x:Name="Canvas" Background="White" EditingMode="Ink"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ScrollViewer>
        </Border>
        <TextBlock Grid.Row="2" Margin="0,10,0,0" Text="保存会生成新的固定版本；取消不会修改原材料。笔迹坐标、压力与顺序会与 PNG 一并保留。"
                   Foreground="{StaticResource PimMutedTextBrush}" />
    </Grid>
</Window>
