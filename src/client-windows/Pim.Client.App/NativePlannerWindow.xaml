<Window x:Class="Pim.Client.App.NativePlannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="原生日历与任务" Height="800" Width="1220" MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PimMutedSurfaceBrush}"
        Loaded="OnLoaded" Closed="OnClosed">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <Button Content="刷新当前页" DockPanel.Dock="Right"
                    Style="{StaticResource PimSecondaryButton}"
                    Click="OnRefreshCurrent" />
            <StackPanel>
                <TextBlock Text="原生日历与任务" FontSize="24" FontWeight="SemiBold"
                           Foreground="{StaticResource PimTextBrush}" />
                <TextBlock Text="直接读取和写入当前账户的日历、日程、任务本与任务；Web 页面仍保留为兼容入口。"
                           Margin="0,4,0,0" FontSize="12"
                           Foreground="{StaticResource PimMutedTextBrush}" />
            </StackPanel>
        </DockPanel>

        <TabControl x:Name="PlannerTabs" Grid.Row="1"
                    Background="{StaticResource PimSurfaceBrush}"
                    BorderBrush="{StaticResource PimBorderBrush}"
                    BorderThickness="1">
            <TabItem Header="日程">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="370" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{StaticResource PimSurfaceBrush}"
                            BorderBrush="{StaticResource PimBorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <WrapPanel Margin="0,0,0,12">
                                <ComboBox x:Name="EventRangeBox" Width="105" Height="34" Margin="0,0,8,0"
                                          SelectionChanged="OnEventFilterChanged" />
                                <ComboBox x:Name="CalendarFilterBox" Width="150" Height="34" Margin="0,0,8,0"
                                          SelectionChanged="OnEventFilterChanged" />
                                <TextBox x:Name="EventSearchBox" Width="220" Height="34" Padding="8,5"
                                         Margin="0,0,8,0" VerticalContentAlignment="Center"
                                         TextChanged="OnEventSearchChanged" ToolTip="搜索日程标题" />
                                <Button Content="读取" Style="{StaticResource PimSecondaryButton}"
                                        Height="34" Click="OnRefreshEvents" />
                            </WrapPanel>
                            <ListBox x:Name="EventList" Grid.Row="1"
                                     BorderBrush="{StaticResource PimBorderBrush}"
                                     Background="{StaticResource PimMutedSurfaceBrush}"
                                     SelectionChanged="OnEventSelected">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PimTextBrush}" />
                                            <TextBlock Text="{Binding Subtitle}" Margin="0,3,0,0"
                                                       FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource PimMutedTextBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="EventListStateText" Grid.Row="2"
                                       Margin="0,10,0,0" Text="正在读取日程…"
                                       TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource PimMutedTextBrush}" />
                            <Border Grid.Row="3" Height="1" Margin="0,10,0,0"
                                    Background="{StaticResource PimBorderBrush}" />
                            <TextBlock x:Name="EventDetailText" Grid.Row="3"
                                       Margin="0,18,0,0" Text="选择日程查看详情。"
                                       TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource PimTextBrush}" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource PimSurfaceBrush}"
                            BorderBrush="{StaticResource PimBorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="新建日程" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource PimTextBrush}" />
                                <TextBlock Text="写入所选日历；不会调用 Outlook 或其它外部写回。"
                                           Margin="0,4,0,14" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource PimMutedTextBrush}" />

                                <TextBlock Text="日历" FontSize="12" Foreground="{StaticResource PimMutedTextBrush}" />
                                <ComboBox x:Name="EventCalendarBox" Height="34" Margin="0,5,0,10" />

                                <TextBlock Text="标题" FontSize="12" Foreground="{StaticResource PimMutedTextBrush}" />
                                <TextBox x:Name="EventTitleBox" Height="34" Padding="8,5" Margin="0,5,0,10"
                                         VerticalContentAlignment="Center" MaxLength="255" />

                                <CheckBox x:Name="AllDayCheckBox" Content="全天"
                                          Checked="OnAllDayChanged" Unchecked="OnAllDayChanged"
                                          Foreground="{StaticResource PimTextBrush}" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="开始日期" FontSize="12"
                                                   Foreground="{StaticResource PimMutedTextBrush}" />
                                        <DatePicker x:Name="EventStartDate" Height="34" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="结束日期" FontSize="12"
                                                   Foreground="{StaticResource PimMutedTextBrush}" />
                                        <DatePicker x:Name="EventEndDate" Height="34" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="开始时间 HH:mm" FontSize="12"
                                                   Foreground="{StaticResource PimMutedTextBrush}" />
                                        <TextBox x:Name="EventStartTimeBox" Text="09:00"
                                                 Height="34" Padding="8,5" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="结束时间 HH:mm" FontSize="12"
                                                   Foreground="{StaticResource PimMutedTextBrush}" />
                                        <TextBox x:Name="EventEndTimeBox" Text="10:00"
                                                 Height="34" Padding="8,5" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="地点" FontSize="12" Foreground="{StaticResource PimMutedTextBrush}" />
                                <TextBox x:Name="EventLocationBox" Height="34" Padding="8,5" Margin="0,5,0,10"
                                         VerticalContentAlignment="Center" MaxLength="500" />
                                <TextBlock Text="说明" FontSize="12" Foreground="{StaticResource PimMutedTextBrush}" />
                                <TextBox x:Name="EventDescriptionBox" Height="72" Padding="8,5" Margin="0,5,0,12"
                                         AcceptsReturn="True" TextWrapping="Wrap" />

                                <Button x:Name="CreateEventButton" Content="创建日程"
                                        Style="{StaticResource PimPrimaryButton}"
                                        HorizontalAlignment="Left" Click="OnCreateEvent" />
                                <TextBlock x:Name="EventCreateStateText" Margin="0,10,0,0"
                                           Text="" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource PimMutedTextBrush}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="任务">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="370" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{StaticResource PimSurfaceBrush}"
                            BorderBrush="{StaticResource PimBorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <WrapPanel Margin="0,0,0,12">
                                <ComboBox x:Name="TaskStatusFilterBox" Width="120" Height="34" Margin="0,0,8,0"
                                          SelectionChanged="OnTaskFilterChanged" />
                                <TextBox x:Name="TaskSearchBox" Width="240" Height="34" Padding="8,5"
                                         Margin="0,0,8,0" VerticalContentAlignment="Center"
                                         TextChanged="OnTaskSearchChanged" ToolTip="搜索任务标题" />
                                <Button Content="读取" Style="{StaticResource PimSecondaryButton}"
                                        Height="34" Click="OnRefreshTasks" />
                                <Button x:Name="CompleteTaskButton" Content="标记所选完成"
                                        Style="{StaticResource PimPrimaryButton}" Height="34"
                                        Margin="8,0,0,0" IsEnabled="False" Click="OnCompleteTask" />
                            </WrapPanel>
                            <ListBox x:Name="TaskList" Grid.Row="1"
                                     BorderBrush="{StaticResource PimBorderBrush}"
                                     Background="{StaticResource PimMutedSurfaceBrush}"
                                     SelectionChanged="OnTaskSelected">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource PimTextBrush}" />
                                                <TextBlock Text="{Binding Subtitle}" Margin="0,3,0,0"
                                                           FontSize="11" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource PimMutedTextBrush}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{Binding StatusBrush}"
                                                    CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="11"
                                                           Foreground="White" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="TaskListStateText" Grid.Row="2"
                                       Margin="0,10,0,0" Text="正在读取任务…"
                                       TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource PimMutedTextBrush}" />
                            <Border Grid.Row="3" Height="1" Margin="0,10,0,0"
                                    Background="{StaticResource PimBorderBrush}" />
                            <TextBlock x:Name="TaskDetailText" Grid.Row="3"
                                       Margin="0,18,0,0" Text="选择任务查看详情。"
                                       TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource PimTextBrush}" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource PimSurfaceBrush}"
                            BorderBrush="{StaticResource PimBorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="新建任务" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource PimTextBrush}" />
                                <TextBlock Text="默认进入所选任务本；留空则由服务器按账户规则归档。"
                                           Margin="0,4,0,14" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource PimMutedTextBrush}" />

                                <TextBlock Text="标题" FontSize="12" Foreground="{StaticResource PimMutedTextBrush}" />
                                <TextBox x:Name="TaskTitleBox" Height="34" Padding="8,5" Margin="0,5,0,10"
                                         VerticalContentAlignment="Center" MaxLength="255" />

                                <TextBlock Text="优先级（1 最高，9 最低）" FontSize="12"
                                           Foreground="{StaticResource PimMutedTextBrush}" />
                                <ComboBox x:Name="TaskPriorityBox" Height="34" Margin="0,5,0,10" />

                                <TextBlock Text="任务本" FontSize="12" Foreground="{StaticResource PimMutedTextBrush}" />
                                <ComboBox x:Name="TaskBookBox" Height="34" Margin="0,5,0,10" />

                                <TextBlock Text="到期日期" FontSize="12" Foreground="{StaticResource PimMutedTextBrush}" />
                                <DatePicker x:Name="TaskDueDate" Height="34" Margin="0,5,0,12" />

                                <Button x:Name="CreateTaskButton" Content="创建任务"
                                        Style="{StaticResource PimPrimaryButton}"
                                        HorizontalAlignment="Left" Click="OnCreateTask" />
                                <TextBlock x:Name="TaskCreateStateText" Margin="0,10,0,0"
                                           Text="" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource PimMutedTextBrush}" />

                                <Border Height="1" Margin="0,18,0,14"
                                        Background="{StaticResource PimBorderBrush}" />
                                <TextBlock Text="任务本" FontWeight="SemiBold"
                                           Foreground="{StaticResource PimTextBrush}" />
                                <ListBox x:Name="TaskBooksList" Height="150" Margin="0,6,0,0"
                                         Background="{StaticResource PimMutedSurfaceBrush}"
                                         BorderBrush="{StaticResource PimBorderBrush}"
                                         DisplayMemberPath="Label" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
