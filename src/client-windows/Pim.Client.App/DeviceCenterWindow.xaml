<Window x:Class="Pim.Client.App.DeviceCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设备中心" Height="680" Width="1040" MinHeight="540" MinWidth="840"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PimMutedSurfaceBrush}"
        Loaded="OnLoaded" Closed="OnClosed">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource PimSurfaceBrush}"
                BorderBrush="{StaticResource PimBorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <Button Content="刷新设备" DockPanel.Dock="Right"
                            Style="{StaticResource PimSecondaryButton}"
                            Click="OnRefresh" />
                    <StackPanel>
                        <TextBlock Text="设备中心" FontSize="23" FontWeight="SemiBold"
                                   Foreground="{StaticResource PimTextBrush}" />
                        <TextBlock Text="账户内已登记端点的原生只读状态与采集质量"
                                   Margin="0,4,0,0" FontSize="12"
                                   Foreground="{StaticResource PimMutedTextBrush}" />
                    </StackPanel>
                </DockPanel>
                <ListBox x:Name="DevicesList" Grid.Row="1"
                         BorderBrush="{StaticResource PimBorderBrush}"
                         Background="{StaticResource PimMutedSurfaceBrush}"
                         SelectionChanged="OnDeviceSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               Foreground="{StaticResource PimTextBrush}" />
                                    <TextBlock Text="{Binding Subtitle}" Margin="0,3,0,0"
                                               FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource PimMutedTextBrush}" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{Binding PresenceBrush}"
                                        CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PresenceLabel}" FontSize="11"
                                               Foreground="White" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="ListStateText" Grid.Row="2" Margin="0,10,0,0"
                           Text="正在读取设备…" TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource PimMutedTextBrush}" />
            </Grid>
        </Border>

        <Border Grid.Column="2" Background="{StaticResource PimSurfaceBrush}"
                BorderBrush="{StaticResource PimBorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="设备详情" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource PimTextBrush}" />
                    <TextBlock Text="采集质量由服务器按所选设备计算；这里不会远程控制设备。"
                               Margin="0,4,0,12" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource PimMutedTextBrush}" />
                    <Button x:Name="LoadQualityButton" Content="检查采集质量"
                            HorizontalAlignment="Left" Margin="0,0,0,14"
                            IsEnabled="False" Style="{StaticResource PimPrimaryButton}"
                            Click="OnLoadQuality" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="DetailText" Text="选择左侧设备查看详情。"
                                   TextWrapping="Wrap" Foreground="{StaticResource PimTextBrush}" />
                        <Border Height="1" Margin="0,16,0,12"
                                Background="{StaticResource PimBorderBrush}" />
                        <TextBlock Text="采集质量" FontWeight="SemiBold"
                                   Foreground="{StaticResource PimTextBrush}" />
                        <TextBlock x:Name="QualityText" Text="尚未检查。"
                                   Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource PimMutedTextBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
